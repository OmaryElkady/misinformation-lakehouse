# Production environment overrides — S3 storage mode
# Copy this file locally and fill in real values. Never commit secrets.
#
# Usage: set these in your shell, or load via: source .env.production
#
STORAGE_MODE=s3
LOCAL_DELTA_PATH=./data/delta
MLFLOW_TRACKING_URI=http://localhost:5000

# AWS credentials — replace placeholders with real values
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=<your-s3-bucket-name>
