# ─── Bluesky API ───────────────────────────────────────────────────────────────
# Create an app at https://www.bsky.app
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Groq API (free tier LLM inference) ───────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── AWS (optional — only needed for S3/production branch) ────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=misinformation-lakehouse-dev

# ─── Storage ──────────────────────────────────────────────────────────────────
# Set to "local" for dev/CI, "s3" for production
STORAGE_MODE=local
LOCAL_DELTA_PATH=./data/delta

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=misinformation-detection

# ─── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MODEL_NAME=misinformation-roberta-v1   # registered name in MLflow Model Registry

# ─── Prefect ──────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ─── ngrok (expose local MLflow to Google Colab) ──────────────────────────────
# Get a free token at https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your_ngrok_token_here

# ─── Training exports ─────────────────────────────────────────────────────────
GOLD_EXPORT_PATH=./data/exports
